.page { flex-grow: 1; min-height: 0; padding-left: 12px; padding-right: 12px; padding-top: 10px; padding-bottom: 20px; }
.intro, .section > .unity-label, #candidates .unity-button { white-space: normal; }
.title { font-size: 18px; -unity-font-style: bold; margin-bottom: 6px; }
.heading { font-size: 14px; -unity-font-style: bold; margin-bottom: 5px; }
.section { margin-top: 12px; padding: 10px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #555; border-right-color: #555; border-top-color: #555; border-bottom-color: #555; }
.row { flex-direction: row; align-items: center; margin-top: 5px; margin-bottom: 5px; }
.row > * { margin-right: 8px; }
.page .unity-base-field__label { width: auto; min-width: 0; flex-shrink: 0; margin-right: 6px; }
.map-choices { height: 160px; flex-shrink: 0; }
.map-choices .unity-toggle { flex-grow: 0; width: auto; margin-top: 5px; }
.map-choices .unity-toggle__input { margin-left: 0; }
.grow { flex-grow: 1; }
.coordinate { min-width: 0; flex-grow: 1; }
.coordinate-actions { justify-content: flex-end; }
.limit { min-width: 0; width: 240px; }
.zoom-controls { margin-top: 4px; margin-bottom: 2px; align-self: stretch; }
.zoom-controls .unity-slider-int { flex-grow: 1; min-width: 240px; }
.map-source { flex-wrap: wrap; margin-top: 2px; margin-bottom: 2px; }
.map-source > * { flex-shrink: 0; margin-top: 2px; margin-bottom: 2px; }
.map-source #map-source-link { height: 22px; }
.map-workspace { flex-direction: row; align-items: stretch; margin-top: 6px; }
.map-column { flex-grow: 1; flex-shrink: 1; min-width: 0; }
.map { height: 400px; overflow: hidden; background-color: #c1ced0; margin-bottom: 4px; }
.map-side-panel { width: 28%; min-width: 260px; max-width: 380px; height: 430px; margin-left: 10px; padding: 10px; border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px; border-left-color: #666; border-right-color: #666; border-top-color: #666; border-bottom-color: #666; }
.page.narrow .map-workspace { flex-direction: column; }
.page.narrow .map-column { flex-grow: 0; }
.page.narrow .map { height: 320px; }
.page.narrow .map-side-panel { width: auto; max-width: 100%; margin-left: 0; margin-top: 10px; }
.primary-action { height: 46px; font-size: 14px; -unity-font-style: bold; background-color: #34689e; color: white; }
.map-search-button { margin-top: 10px; margin-bottom: 8px; }
.download-actions { margin-top: 10px; }
.download-action { flex-grow: 1; }
.download-actions #cancel { min-width: 90px; height: 46px; }
.map-query-results { flex-grow: 1; min-height: 0; }
.map-layer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.map-summary { white-space: normal; margin-top: 6px; -unity-font-style: bold; }
.map-legend { white-space: normal; margin-bottom: 4px; }
.download-summary { white-space: normal; margin-top: 5px; -unity-font-style: bold; }
.mesh-badge { position: absolute; background-color: #6e1bb3; color: white; padding-left: 5px; padding-right: 5px; -unity-font-style: bold; }
.attribution { position: absolute; right: 5px; bottom: 5px; background-color: #ffffffdd; color: #222; padding-left: 4px; padding-right: 4px; }
.attribution.google-attribution { max-width: 65%; white-space: normal; }
.google-logo { position: absolute; left: 10px; bottom: 5px; width: 105px; height: 22px; display: none; }
.map-message { position: absolute; left: 10px; right: 10px; top: 10px; white-space: normal; background-color: #ffffffee; color: #222; padding: 6px; display: none; }
.result { white-space: normal; margin-top: 5px; margin-bottom: 5px; }
